{
  "name": "agent-prd-automation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @agent/api dev",
    "dev:web": "pnpm --filter @agent/web dev",
    "dev:worker": "pnpm --filter @agent/worker dev",
    "eval:golden": "pnpm --filter @agent/evals eval -- --fixtures ../../evals/golden-issues --candidates ../../evals/candidates --out ../../artifacts/eval-report.json --markdown ../../artifacts/eval-report.md --min-score 0.8",
    "onboard:repo": "pnpm --filter @agent/codebase-intelligence onboard --",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.2.4",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}
