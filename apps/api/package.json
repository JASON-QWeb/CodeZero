{
  "name": "@agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent/config": "workspace:*",
    "@agent/memory": "workspace:*",
    "@agent/observability": "workspace:*",
    "@agent/orchestrator": "workspace:*",
    "@agent/persistence": "workspace:*",
    "@agent/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "bullmq": "^5.64.1",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
