OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# One active model provider is enough. Use Settings Console to switch provider,
# save the matching API key env var, and update config/codezero.yaml.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
AGENT_TRIGGER_MENTION=@codezero
DATA_DIR=./data
TASK_STORE_FILE=./data/tasks.json
MEMORY_STORE_FILE=./data/memory.json
STORAGE_DRIVER=file
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_prd
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MOCK_DATA=0
# Official Understand-Anything project knowledge graph integration
UNDERSTAND_ANYTHING_LANGUAGE=zh
UNDERSTAND_ANYTHING_TIMEOUT_MS=5400000
# UNDERSTAND_ANYTHING_PLUGIN_ROOT=/absolute/path/to/understand-anything-plugin
# CODEX_COMMAND=codex
